@model Neksara.Models.Topic
@{
    ViewData["Title"] = "Tambah Topik";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h3 class="mb-4">➕ Tambah Topik</h3>
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <li>@error.ErrorMessage</li>
        }
        </ul>
    </div>
}
<form asp-controller="Admin" asp-action="CreateTopic" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label fw-bold">Kategori</label>
        <select asp-for="IdCategory" class="form-control">
            <option value="">-- Pilih Kategori --</option>
            @foreach (var c in ViewBag.Categories)
            {
                <option value="@c.CategoriesId">@c.CategoryName</option>
            }
        </select>
        <span asp-validation-for="IdCategory" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Nama Topik</label>
        <input asp-for="TopicName" class="form-control" placeholder="Contoh: ASP.NET MVC Dasar" />
        <span asp-validation-for="TopicName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Isi Materi</label>
        <textarea asp-for="Body" rows="5" class="form-control"
                  placeholder="Tuliskan isi materi topik..."></textarea>
        <span asp-validation-for="Body" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Video URL</label>
        <input asp-for="VideoUrl" class="form-control"
               placeholder="https://youtube.com/..." />
        <span asp-validation-for="VideoUrl" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">
            💾 Simpan
        </button>
        <a href="/Admin/Topics" class="btn btn-secondary">
            ⬅️ Kembali
        </a>
    </div>
</form>
