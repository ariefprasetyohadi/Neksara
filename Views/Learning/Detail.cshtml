@model Neksara.Models.Topic
@{
    ViewData["Title"] = Model.TopicName;
}

<a href="/Learning" class="btn btn-secondary mb-3">
    ⬅️ Kembali
</a>

<div class="card shadow">
    <div class="card-body">
        <span class="badge bg-primary mb-2">
            @Model.Category.CategoryName
        </span>

        <h3 class="mt-2">@Model.TopicName</h3>

        <p class="text-muted">
            👁 @Model.ViewCount kali dilihat
        </p>

        <hr />

        <p style="white-space: pre-line;">
            @Model.Body
        </p>

        @if (!string.IsNullOrEmpty(Model.VideoUrl))
        {
            <hr />
            <h5>🎥 Video Pembelajaran</h5>
            <a href="@Model.VideoUrl" target="_blank" class="btn btn-danger">
                ▶️ Tonton Video
            </a>
        }
    </div>
</div>
